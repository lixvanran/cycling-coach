{
  "name": "cycling-coach-workspace",
  "version": "0.5.3",
  "private": true,
  "description": "Cycling Coach - 公路自行车 AI 教练 (pnpm monorepo root)",
  "scripts": {
    "build:win": "echo [搁置] 桌面端 V0.5.3 闪退, V0.8+ 重启",
    "dev:web": "cd apps/web && pnpm dev",
    "dev:desktop": "echo [搁置] 桌面端 V0.5.3 闪退, V0.8+ 重启",
    "clean": "node -e \"const fs=require('fs');for(const d of ['dist','build','apps/web/dist','apps/desktop/dist-electron','apps/desktop/build-resources/backend','cycling_coach/static']){try{fs.rmSync(d,{recursive:true,force:true});console.log('cleaned',d)}catch(e){}}\""
  },
  "devDependencies": {
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  }
}
