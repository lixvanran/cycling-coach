{
  "name": "cycling-coach-desktop",
  "productName": "Cycling Coach",
  "version": "0.5.3",
  "description": "Cycling Coach 桌面端 - Electron + electron-builder",
  "main": "main.cjs",
  "author": "Cycling Coach Team",
  "license": "MIT (软件) + KB Restricted (训练百科)",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:dir": "electron-builder --dir",
    "pack": "electron-builder --dir"
  },
  "dependencies": {},
  "build": {
    "appId": "com.cyclingcoach.desktop",
    "productName": "Cycling Coach",
    "copyright": "Copyright © 2026 Cycling Coach Team",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "build/installerIcon.svg",
      "build/icon.png",
      "build/icon.ico",
      "build/icon.icns"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../build-resources/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../kb_source",
        "to": "kb_source",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CyclingCoach-Setup-${version}-${arch}.${ext}",
      "publisherName": "Cycling Coach Team"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cycling Coach",
      "shortcutDescription": "公路自行车 AI 教练 · 训练百科",
      "allowElevation": true,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "displayLanguageSelector": true,
      "installerIcon": "build/icon.ico",
      "uninstallDisplayName": "Cycling Coach",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Sports",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^26.15.0",
    "electron-builder": "^24.13.0",
    "electron-log": "^5.0.0"
  }
}