# ===== Cycling Coach 配置 =====
# 复制为 .env 后填入真实值(.env 不进 git)

# LLM 配置(OpenRouter 兼容协议)
# 不填 M3_API_KEY 会进入 mock 模式(返回假数据,适合离线开发)
M3_BASE_URL=https://openrouter.ai/api/v1
M3_API_KEY=
# minimax-m3 在 AtlasCloud provider 配错,临时用 m2.7(主模型空响应自动降级)
M3_MODEL=minimax/minimax-m3

# 后端
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
LOG_LEVEL=INFO

# 前端
FRONTEND_PORT=1420

# CORS(开发模式)
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420
