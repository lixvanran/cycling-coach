# Auto detect text files and normalize line endings
* text=auto

# Force LF for source code
*.py        text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.svg       text eol=lf
*.sh        text eol=lf
*.bat       text eol=lf diff=bat
*.cjs       text eol=lf
*.mjs       text eol=lf
*.spec      text eol=lf

# Binary
*.fit       binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.webp      binary
*.mp4       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.sqlite    binary
*.db        binary

# Linguist overrides
docs/* linguist-documentation
