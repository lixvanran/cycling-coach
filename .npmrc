# pnpm 安装/解析行为
# 中国大陆常见网络环境,默认走 npmmirror
registry=https://registry.npmmirror.com

# ---- 安全白名单:pnpm 9/10 默认禁止运行 postinstall,
# 这里显式 allow esbuild(只有它需要下载 platform binary)
# 数组写法兼容 pnpm v9 和 v10+;
# 与 pnpm-workspace.yaml 的 onlyBuiltDependencies 互为冗余,任意一处生效即可
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=@swc/core
onlyBuiltDependencies[]=core-js
onlyBuiltDependencies[]=better-sqlite3
onlyBuiltDependencies[]=sharp
onlyBuiltDependencies[]=esbuild-windows-64
onlyBuiltDependencies[]=esbuild-windows-32
onlyBuiltDependencies[]=esbuild-linux-64
onlyBuiltDependencies[]=esbuild-linux-32
onlyBuiltDependencies[]=esbuild-darwin-64
onlyBuiltDependencies[]=esbuild-darwin-arm64

# 兼容性:避免老项目 hoist 失败
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true
# pnpm 11+ hoist 共享 devDeps 到根, 让 require('electron') 能解析
hoist=true
